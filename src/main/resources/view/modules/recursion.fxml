<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ScrollPane?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dsavisualizer.controller.modules.RecursionController"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12;">

    <!-- Top: Title centered, Theme & Home buttons top-right -->
    <top>
        <BorderPane style="-fx-padding: 15 20 10 20; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <center>
                <Label fx:id="titleLabel" text="Recursion" 
                       style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </center>
            <right>
                <HBox spacing="10" alignment="TOP_RIGHT">
                    <Button fx:id="themeBtn" text="Dark Mode" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                    <Button fx:id="backBtn" text="Home" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- Main content: Left panel + Unified Visualization Area -->
    <center>
        <HBox spacing="15" style="-fx-padding: 15;">
            
            <!-- LEFT PANEL: Story and Controls -->
            <VBox spacing="12" style="-fx-padding: 10; -fx-min-width: 280; -fx-max-width: 320; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #f9f9f9;">
                
                <!-- Story/Notes Box -->
                <Label text="📖 Story" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <TextArea fx:id="storyArea" 
                          editable="false" 
                          wrapText="true" 
                          prefHeight="150"
                          style="-fx-font-size: 14;-fx-font-family: 'Consolas'; -fx-control-inner-background: #e7f5ff;"/>
                
                <!-- Module controls will be injected here by controller -->
                <TextField fx:id="inputField" promptText="n or string"
                           style="-fx-font-size: 14; -fx-padding: 8;"/>

                <VBox fx:id="moduleControls" spacing="8" VBox.vgrow="ALWAYS"/>
                
                <VBox spacing="15" VBox.vgrow="ALWAYS">
                    <Button fx:id="startBtn"  text="Start"  prefHeight="50" prefWidth="200" style="-fx-font-size: 20; -fx-padding: 10 15; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button fx:id="pauseBtn" text="Pause" prefHeight="50" prefWidth="200" style="-fx-font-size: 20; -fx-padding: 10 15; -fx-background-color: #f0ad4e; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <HBox spacing="10">
                        <Button fx:id="prevBtn" text="Previous" prefHeight="50" prefWidth="95" style="-fx-font-size: 16; -fx-padding: 10 15; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Button fx:id="nextBtn" text="Next" prefHeight="50" prefWidth="95" style="-fx-font-size: 16; -fx-padding: 10 15; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                    <Button fx:id="clearBtn" text="Clear" prefHeight="50" prefWidth="200" style="-fx-font-size: 20; -fx-padding: 10 15; -fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </VBox>
                
                <!-- Show Code Button with Copy -->
                <HBox spacing="8">
                    <Button fx:id="showCodeBtn" text="Show Code" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-font-weight: bold; -fx-background-color: #3F51B5; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="copyCodeBtn" text="Copy" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="70"/>
                </HBox>
            </VBox>

            <!-- RIGHT PANEL: UNIFIED VISUALIZATION AREA (Code + Function Calls) -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" style="-fx-background-color: #f5f5f5; -fx-padding: 15;">
                
                <!-- Status Label -->


                <!-- Main Visualization Container: Code (left) + Call Stack (right) -->
                <HBox spacing="20" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    
                    <!-- CODE SECTION: Top-Left -->

                    
                    <!-- FUNCTION CALL STACK SECTION: Below Code or Right -->
                    <VBox spacing="5" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #ddd; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                        <Label text="Function Call Stack:" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
<!--                        <Pane fx:id="callStackPane" VBox.vgrow="ALWAYS" style="-fx-background-color: #f9f9f9; -fx-min-height: 300; -fx-border-color: #eee; -fx-border-width: 1;"/>-->

                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <content>
                                <Pane fx:id="callStackPane"
                                      style="-fx-background-color: #f9f9f9; -fx-min-height: 300; -fx-border-color: #eee; -fx-border-width: 1;"/>
                            </content>
                        </ScrollPane>
                        <Label fx:id="finalAnswerLabel" text="" style="-fx-font-size: 16; -fx-text-fill: navy; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>
                    </VBox>


                </HBox>
                <Label fx:id="statusLabel" text="Recursion ready"
                       style="-fx-font-size: 14; -fx-text-fill: darkblue; -fx-font-weight: bold;"/>
                <Label fx:id="returnLabel"
                       text=""
                       style="-fx-font-size: 14; -fx-text-fill: green; -fx-font-weight: bold;"/>

                <VBox spacing="5">
                    <Label text="Code" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <TextArea fx:id="codeArea"
                              editable="false"
                              wrapText="false"
                              prefHeight="200"
                              style="-fx-control-inner-background: #1e1e1e; -fx-text-fill: #d4d4d4; -fx-font-family: 'Courier New'; -fx-font-size: 11; -fx-padding: 10;"/>
                </VBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
