<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>



<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dsavisualizer.controller.modules.SortingController"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12;">

    <!-- Top: Title centered, Theme & Home buttons top-right -->
    <top>
        <BorderPane style="-fx-padding: 15 20 10 20; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <center>
                <Label fx:id="titleLabel" text="Sorting Algorithms"
                       style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </center>
            <right>
                <HBox spacing="10" alignment="TOP_RIGHT">
                    <Button fx:id="themeBtn" text="Dark Mode" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                    <Button fx:id="backBtn" text="Home" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- Main content: Left panel + Center visualization -->
    <center>
        <HBox spacing="15" style="-fx-padding: 15;">

            <!-- LEFT PANEL: Story and Operations -->
            <VBox spacing="12" style="-fx-padding: 10; -fx-min-width: 280; -fx-max-width: 320; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #f9f9f9;">

                <!-- Story/Notes Box -->
                <Label text="📖 Story" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <TextArea fx:id="storyArea"
                          editable="false"
                          wrapText="true"
                          prefHeight="100"
                          style="-fx-font-size: 14;-fx-font-family: 'Consolas'; -fx-control-inner-background: #e7f5ff;"/>

                <!-- Input Section -->
                <VBox spacing="6">
                    <Label text="Input (comma separated)" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                    <TextField fx:id="inputField" promptText="e.g. 5,3,8,1,9" style="-fx-font-size: 13; -fx-padding: 8;"/>
                    <HBox spacing="8">
                        <Button fx:id="buildBtn" text="Build" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <!-- Algorithm Selection -->
                <Label text="Algorithm" style="-fx-font-weight: bold; -fx-padding: 8 0 0 0; -fx-font-size: 13;"/>
                <ComboBox fx:id="algoCombo" prefWidth="200" style="-fx-font-size: 13; -fx-padding: 8;" />

                <!-- Speed Control -->
                <Label text="Speed" style="-fx-font-weight: bold; -fx-padding: 8 0 0 0; -fx-font-size: 13;"/>
                <Slider fx:id="speedSlider" min="0.1" max="2" value="1" prefWidth="200" />

                <!-- Control Buttons -->
                <HBox spacing="6">
                    <Button fx:id="startBtn" text="Start" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="pauseBtn" text="Pause" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="resetBtn" text="Reset" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Navigation -->
                <HBox spacing="8">
                    <Button fx:id="prevBtn" text="← Previous" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="nextBtn" text="Next →" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Show Code Button with Copy -->
                <HBox spacing="8">
                    <Button fx:id="showCodeBtn" text="Show Code" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-font-weight: bold; -fx-background-color: #3F51B5; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="copyCodeBtn" text="Copy" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="70"/>
                </HBox>
            </VBox>

            <!-- CENTER/RIGHT PANEL: Visualization + Code -->
            <VBox spacing="12" HBox.hgrow="ALWAYS">

                <!-- Input Array Display -->
                <VBox spacing="5">
                    <Label text="📥 Input Array" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1976D2;"/>
                    <HBox fx:id="inputArrayBox" spacing="8" style="-fx-padding: 10; -fx-background-color: #E3F2FD; -fx-border-color: #1976D2; -fx-border-radius: 3; -fx-border-width: 2;" alignment="CENTER_LEFT"/>
                </VBox>

                <!-- Visualization Area -->
                <VBox spacing="8" VBox.vgrow="ALWAYS">
                    <HBox spacing="30" alignment="CENTER_LEFT">
                        <Label text="Visualization" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                        <Label fx:id="stepInfoLabel" text="Step: 0/0" style="-fx-font-size: 13; -fx-text-fill: #2196F3;"/>
                        <Label fx:id="actionLabel" text="" style="-fx-font-size: 13; -fx-text-fill: #FF6F00; -fx-font-style: italic;"/>
                    </HBox>
                    <StackPane style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #f5f5f5;" VBox.vgrow="ALWAYS">
                        <ScrollPane fx:id="vizScroll" fitToHeight="true" fitToWidth="true">
                            <HBox fx:id="vizArea" spacing="15" style="-fx-padding: 20; -fx-alignment: CENTER; -fx-spacing: 15;" alignment="CENTER"/>
                        </ScrollPane>
                    </StackPane>
                </VBox>

                <!-- Output Array Display -->
                <VBox spacing="5">
                    <Label text="📤 Output Array (Final Result)" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #388E3C;"/>
                    <HBox fx:id="outputArrayBox" spacing="8" style="-fx-padding: 10; -fx-background-color: #E8F5E9; -fx-border-color: #388E3C; -fx-border-radius: 3; -fx-border-width: 2;" alignment="CENTER_LEFT"/>
                </VBox>

                <!-- Code Box -->
                <VBox spacing="5">
                    <Label text="Code" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <TextArea fx:id="codeArea"
                              editable="false"
                              wrapText="false"
                              prefHeight="200"
                              style="-fx-control-inner-background: #1e1e1e; -fx-text-fill: #d4d4d4; -fx-font-family: 'Courier New'; -fx-font-size: 11; -fx-padding: 10;"/>
                </VBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>