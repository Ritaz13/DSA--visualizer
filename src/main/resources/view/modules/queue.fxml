<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dsavisualizer.controller.modules.QueueController"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12;">

    <!-- Top: Title centered, Theme & Home buttons top-right -->
    <top>
        <BorderPane style="-fx-padding: 15 20 10 20; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <center>
                <Label fx:id="titleLabel" text="Queue"
                       style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </center>
            <right>
                <HBox spacing="10" alignment="TOP_RIGHT">
                    <Button fx:id="themeBtn" text="Dark Mode" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                    <Button fx:id="backBtn" text="Home" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- Main content: Left panel + Center visualization -->
    <center>
        <HBox spacing="15" style="-fx-padding: 15;" >

            <!-- LEFT PANEL: Story and Operations -->
            <VBox spacing="12" VBox.vgrow="ALWAYS"
                  style="-fx-padding: 10; -fx-min-width: 280; -fx-max-width: 320; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #f9f9f9;">

            <!-- Story/Notes Box -->
            <Label text="📖 Story" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
            <TextArea fx:id="storyArea"
                      editable="false"
                      wrapText="true"
                      prefHeight="120"
                      style="-fx-font-size: 14;-fx-font-family: 'Consolas'; -fx-control-inner-background: #e7f5ff;"/>

            <!-- Queue Type -->
            <Label text="Queue Type" style="-fx-font-weight: bold; -fx-padding: 8 0 0 0; -fx-font-size: 13;"/>
            <VBox spacing="4">
                <CheckBox fx:id="circularCheck" text="Circular Queue (8 slots)" style="-fx-font-size: 12;" selected="false"/>
                <CheckBox fx:id="priorityCheck" text="Priority Queue" style="-fx-font-size: 12;" selected="false"/>
            </VBox>

            <!-- Input Section -->
            <Label text="Input Value" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
            <TextField fx:id="inputField" promptText="Enter number" style="-fx-font-size: 13; -fx-padding: 8;"/>
            
            <!-- Circular Queue Size Display -->
            <Label fx:id="queueSizeLabel" text="Size: 0/8" style="-fx-font-size: 12; -fx-text-fill: #555;"/>

            <!-- Operations Section -->
            <VBox spacing="8">
                <Label text="Operations" style="-fx-font-weight: bold; -fx-padding: 8 0 0 0; -fx-font-size: 13;"/>
                <HBox spacing="8">
                    <Button fx:id="enqueueBtn" text="Enqueue"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"
                            HBox.hgrow="ALWAYS"/>
                    <Button fx:id="dequeueBtn" text="Dequeue"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"/>

                </HBox>
                <HBox spacing="8">
                    <Button fx:id="frontBtn" text="Front"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;"
                            HBox.hgrow="ALWAYS"/>
                    <Button fx:id="rearBtn" text="Rear"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"
                            HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="8">
                    <Button fx:id="clearBtn" text="Clear"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-weight: bold;"
                            HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Show Code Button with Copy -->
                <HBox spacing="8">
                    <Button fx:id="showCodeBtn" text="Show Code"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-font-weight: bold; -fx-background-color: #3F51B5; -fx-text-fill: white;"
                            HBox.hgrow="ALWAYS"/>
                    <Button fx:id="copyCodeBtn" text="Copy"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="70"/>
                </HBox>
            </VBox>
            </VBox>

            <!-- CENTER/RIGHT PANEL: Visualization + Code -->
            <VBox spacing="12" HBox.hgrow="ALWAYS">

                <!-- Visualization Area -->
                <VBox spacing="8" VBox.vgrow="ALWAYS">
                    <Label text="Visualization (Queue in Vertical)" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <StackPane
                            style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #f5f5f5;"
                            VBox.vgrow="ALWAYS">
                        <ScrollPane fx:id="vizScroll" fitToHeight="true" fitToWidth="true">
                            <HBox fx:id="vizArea" spacing="15" style="-fx-padding:10; -fx-alignment:center;"/>
                        </ScrollPane>
                    </StackPane>
                    <Label fx:id="statusLabel" text="Queue ready"
                           style="-fx-font-size: 14; -fx-text-fill: darkblue; -fx-padding: 6;"/>
                </VBox>

                <!-- Code Box -->
                <VBox spacing="5">
                    <Label text="Code" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <TextArea fx:id="codeArea"
                              editable="false"
                              wrapText="false"
                              prefHeight="200"
                              style="-fx-control-inner-background: #1e1e1e; -fx-text-fill: #d4d4d4; -fx-font-family: 'Courier New'; -fx-font-size: 11; -fx-padding: 10;"/>
                </VBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
