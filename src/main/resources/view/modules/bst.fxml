<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dsavisualizer.controller.modules.BSTController"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12;">

    <!-- Top: Title centered, Theme & Home buttons top-right -->
    <top>
        <BorderPane style="-fx-padding: 15 20 10 20; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <center>
                <Label fx:id="titleLabel" text="Binary Search Tree"
                       style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </center>
            <right>
                <HBox spacing="10" alignment="TOP_RIGHT">
                    <Button fx:id="themeBtn" text="Dark Mode" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                    <Button fx:id="backBtn" text="Home" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- Main content: Left panel + Center visualization -->
    <center>
        <HBox spacing="15" style="-fx-padding: 15;">

            <!-- LEFT PANEL: Story and Operations -->
            <VBox spacing="12"
                  style="-fx-padding: 10; -fx-min-width: 280; -fx-max-width: 320; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #f9f9f9;">

                <!-- Story/Notes Box -->
                <Label text="📖 Story" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <TextArea fx:id="storyArea"
                          editable="false"
                          wrapText="true"
                          prefHeight="120"
                          style="-fx-font-size: 14;-fx-font-family: 'Consolas'; -fx-control-inner-background: #e7f5ff;"/>

                <!-- Input Section -->
                <VBox spacing="6">
                    <Label text="Input Numbers" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                    <TextField fx:id="inputField" promptText="e.g. 5,3,8,1,9"
                               style="-fx-font-size: 13; -fx-padding: 8;"/>
                    <HBox spacing="8">

                        <Button fx:id="randomBtn" text="Random BST"
                                style="-fx-font-size: 13; -fx-padding: 10 15;
                   -fx-background-color: #FF5722;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;"/>


                        <Button fx:id="buildBtn" text="Build Tree"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"
                                HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <!-- Operations Section -->
                <Label text="Operations" style="-fx-font-weight: bold; -fx-padding: 8 0 0 0; -fx-font-size: 13;"/>
                <VBox spacing="6">
                    <TextField fx:id="opField" promptText="Value" style="-fx-font-size: 13; -fx-padding: 8;"/>
                    <HBox spacing="6">
                        <Button fx:id="insertBtn" text="Insert"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"
                                HBox.hgrow="ALWAYS"/>
                        <Button fx:id="deleteBtn" text="Delete"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"
                                HBox.hgrow="ALWAYS"/>
                        <Button fx:id="searchBtn" text="Search"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;"
                                HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="6">
                        <Button fx:id="successorBtn" text=" Successor"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #009688; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Button fx:id="predecessorBtn" text="Predecessor"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #009688; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="6">
                        <Button fx:id="minimumBtn" text="Minimum"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #009688; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Button fx:id="maximumBtn" text="Maximum"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #009688; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="6">
                        <Button fx:id="clearVizBtn" text="Clear View"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #757575; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <!-- Traversal Section -->
                <Label text="Traversal" style="-fx-font-weight: bold; -fx-padding: 8 0 0 0; -fx-font-size: 13;"/>
                <VBox spacing="6">
                    <HBox spacing="6" >
                        <Button fx:id="startBtn" text="▶ Start"
                                style="-fx-font-size: 13; -fx-padding: 8 12; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Button fx:id="stopBtn" text="■ Stop"
                                style="-fx-font-size: 13; -fx-padding: 8 12; -fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"/>




                        <Button fx:id="prevBtn" text="◀ Prev"
                                style="-fx-font-size: 13; -fx-padding: 8 12; -fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Button fx:id="nextBtn" text="Next ▶"
                                style="-fx-font-size: 13; -fx-padding: 8 12; -fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="6">
                        <Label text="Speed:" style="-fx-font-size:12;"/>
                        <Slider fx:id="speedSlider" min="0.5" max="3" value="1" style="-fx-font-size: 12;"/>
                    </HBox>
                    <HBox spacing="6">
                        <Button fx:id="inOrderBtn" text="In-Order"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Button fx:id="preOrderBtn" text="Pre-Order"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="6">
                        <Button fx:id="postOrderBtn" text="Post-Order"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Button fx:id="levelOrderBtn" text="Level-Order"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>



                
                <HBox spacing="8">
                    <Button fx:id="showCodeBtn" text="Show Code"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-font-weight: bold; -fx-background-color: #3F51B5; -fx-text-fill: white;"
                            HBox.hgrow="ALWAYS"/>
                    <Button fx:id="copyCodeBtn" text="Copy"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="70"/>
                </HBox>
            </VBox>

            <!-- CENTER/RIGHT PANEL: Visualization + Code -->
            <VBox spacing="12" HBox.hgrow="ALWAYS">

                <!-- Visualization Area -->
                <VBox spacing="8" VBox.vgrow="ALWAYS">
                    <Label text="Visualization" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <StackPane
                            style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #f5f5f5;"
                            VBox.vgrow="ALWAYS">
                        <ScrollPane fx:id="vizScroll" fitToHeight="true" fitToWidth="true">
                            <StackPane fx:id="vizArea"/>
                        </ScrollPane>

                    </StackPane>
                    <Label fx:id="statusLabel" text=""
                           style="-fx-font-size: 14; -fx-text-fill: darkred; -fx-padding: 6;"/>
                </VBox>

                <!-- Traversal Results -->
                <VBox spacing="5">
                    <Label text="Current Traversal" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <TextArea fx:id="traversalResult" editable="false" wrapText="true" prefHeight="80"
                              style="-fx-control-inner-background: #fff9c4; -fx-font-family: 'Courier New'; -fx-font-size: 12; -fx-padding: 10; -fx-border-color: #f57f17; -fx-border-width: 1; -fx-border-radius: 3;"/>
                </VBox>

                <!-- Code Box -->
                <VBox spacing="5">
                    <Label text="Code" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <TextArea fx:id="codeArea"
                              editable="false"
                              wrapText="false"
                              prefHeight="200"
                              style="-fx-control-inner-background: #2d3748; -fx-text-fill: #e2e8f0; -fx-font-family: 'Fira Code', 'JetBrains Mono', 'Cascadia Code', 'Courier New', monospace; -fx-font-size: 13; -fx-padding: 15; -fx-background-color: #2d3748; -fx-border-color: #4a5568; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-highlight-fill: #4299e1; -fx-highlight-text-fill: white;"/>
                </VBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
