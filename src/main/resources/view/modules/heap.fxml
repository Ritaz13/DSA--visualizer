<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dsavisualizer.controller.modules.HeapController"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12;">

    <!-- Top: Title centered, Theme & Home buttons top-right -->
    <top>
        <BorderPane style="-fx-padding: 15 20 10 20; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <center>
                <Label fx:id="titleLabel" text="Heap"
                       style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </center>
            <right>
                <HBox spacing="10" alignment="TOP_RIGHT">
                    <Button fx:id="themeBtn" text="Dark Mode" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                    <Button fx:id="backBtn" text="Home" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- Main content: Left panel + Center visualization -->
    <center>
        <HBox spacing="15" style="-fx-padding: 15;">

            <!-- LEFT PANEL: Story and Operations -->
            <VBox spacing="12"
                  style="-fx-padding: 10; -fx-min-width: 280; -fx-max-width: 320; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #f9f9f9;">

                <!-- Story/Notes Box -->
                <Label text="📖 Story" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <TextArea fx:id="storyArea"
                          editable="false"
                          wrapText="true"
                          prefHeight="100"
                          style="-fx-font-size: 14;-fx-font-family: 'Consolas'; -fx-control-inner-background: #e7f5ff;"/>

                <!-- Heap Type Selection -->
                <VBox spacing="6">
                    <Label text="Heap Type" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                    <HBox spacing="10">
                        <CheckBox fx:id="maxHeapCheck" text="Max Heap" selected="true"/>
                    </HBox>
                </VBox>

                <!-- Input Section -->
                <VBox spacing="6">
                    <Label text="Input" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                    <TextField fx:id="inputField" promptText="e.g. 5 or 5,3,8,1,9"
                               style="-fx-font-size: 13; -fx-padding: 8;"/>
                    <HBox spacing="8">
                        <Button fx:id="insertBtn" text="Insert"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"
                                HBox.hgrow="ALWAYS"/>
                        <Button fx:id="randomBtn" text="Random"
                                style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #FF5722; -fx-text-fill: white; -fx-font-weight: bold;"
                                HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Button fx:id="buildBtn" text="Build Heap"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"
                            HBox.hgrow="ALWAYS"/>
                </VBox>

                <!-- Operations Section -->
                <Label text="Operations" style="-fx-font-weight: bold; -fx-padding: 8 0 0 0; -fx-font-size: 13;"/>
                <VBox spacing="6">
                    <Button fx:id="extractBtn" text="Extract Root"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;"
                            HBox.hgrow="ALWAYS"/>
                    <Button fx:id="deleteBtn" text="Delete Min/Max"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"
                            HBox.hgrow="ALWAYS"/>
                    <Button fx:id="clearBtn" text="Clear Heap"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-weight: bold;"
                            HBox.hgrow="ALWAYS"/>
                </VBox>

                <!-- Show Code Button with Copy -->
                <HBox spacing="8">
                    <Button fx:id="showCodeBtn" text="Show Code"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-font-weight: bold; -fx-background-color: #3F51B5; -fx-text-fill: white;"
                            HBox.hgrow="ALWAYS"/>
                    <Button fx:id="copyCodeBtn" text="Copy"
                            style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="70"/>
                </HBox>
                <!-- Heap Array Representation -->
                <VBox spacing="5" prefHeight="240">
                    <Label  style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <TextArea fx:id="heapArrayArea"
                              editable="false"
                              wrapText="true"
                              prefHeight="100"
                              style="-fx-control-inner-background: #fffacd; -fx-font-family: 'Courier New'; -fx-font-size: 20; -fx-padding: 10;"/>
                </VBox>
            </VBox>

            <!-- CENTER/RIGHT PANEL: Visualization + Code -->
            <VBox spacing="12" HBox.hgrow="ALWAYS">

                <!-- Visualization Area -->
                <VBox spacing="8" VBox.vgrow="ALWAYS">
                    <Label text="Visualization" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <StackPane
                            style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #f5f5f5;"
                            VBox.vgrow="ALWAYS">
                        <StackPane fx:id="vizArea"/>
                    </StackPane>
                    <Label fx:id="statusLabel" text="Ready to visualize heap"
                           style="-fx-font-size: 14; -fx-text-fill: darkgreen; -fx-padding: 6;"/>
                </VBox>



                <!-- Code Box -->
                <VBox spacing="5">
                    <Label text="Code" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <TextArea fx:id="codeArea"
                              editable="false"
                              wrapText="false"
                              prefHeight="150"
                              style="-fx-control-inner-background: #1e1e1e; -fx-text-fill: #d4d4d4; -fx-font-family: 'Courier New'; -fx-font-size: 11; -fx-padding: 10;"/>
                </VBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
