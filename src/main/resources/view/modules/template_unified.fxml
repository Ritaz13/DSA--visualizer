<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Unified template for all 8 modules -->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            style="-fx-min-height: 100vh;">

    <!-- Top: Title centered, Theme & Home buttons top-right -->
    <top>
        <BorderPane style="-fx-padding: 15 20 10 20; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <center>
                <Label fx:id="titleLabel" text="Module Title" 
                       style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </center>
            <right>
                <HBox spacing="10" alignment="TOP_RIGHT">
                    <Button fx:id="themeBtn" text="Dark Mode" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                    <Button fx:id="backBtn" text="Home" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- Main content: Left panel + Center visualization + Right panel -->
    <center>
        <HBox spacing="15" style="-fx-padding: 15;">
            
            <!-- LEFT PANEL: Story and Operations -->
            <VBox spacing="12" style="-fx-padding: 10; -fx-min-width: 280; -fx-max-width: 320; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #f9f9f9;">
                
                <!-- Story/Notes Box -->
                <Label text="📖 Story" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <TextArea fx:id="storyArea" 
                          editable="false" 
                          wrapText="true" 
                          prefHeight="150"
                          style="-fx-control-inner-background: #ffffff; -fx-font-size: 12;"/>
                
                <!-- Operations Section -->
                <VBox fx:id="operationsSection" spacing="8">
                    <!-- This will be filled by individual controllers -->
                </VBox>

                <!-- Show Code Button -->
                <HBox spacing="8">
                    <Button fx:id="showCodeBtn" text="Show Code" style="-fx-font-size: 12; -fx-padding: 8 15; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="copyCodeBtn" text="Copy" style="-fx-font-size: 12; -fx-padding: 8 15;" prefWidth="60"/>
                </HBox>
                
                <!-- Previous/Next Navigation (if needed) -->
                <HBox fx:id="navBox" spacing="8" visible="false" managed="false">
                    <Button fx:id="prevBtn" text="← Previous" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="nextBtn" text="Next →" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- CENTER/RIGHT PANEL: Visualization + Code + Info -->
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                
                <!-- Visualization Area -->
                <VBox spacing="8" VBox.vgrow="ALWAYS">
                    <Label text="Visualization" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <StackPane style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #f5f5f5;" VBox.vgrow="ALWAYS">
                        <ScrollPane fx:id="vizScroll" fitToHeight="true" fitToWidth="true">
                            <VBox fx:id="vizArea" spacing="10" style="-fx-padding: 10;"/>
                        </ScrollPane>
                    </StackPane>
                </VBox>

                <!-- Code Box -->
                <VBox spacing="5">
                    <Label text="Code" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <TextArea fx:id="codeArea" 
                              editable="false" 
                              wrapText="false" 
                              prefHeight="200"
                              style="-fx-control-inner-background: #1e1e1e; -fx-text-fill: #d4d4d4; -fx-font-family: 'Courier New'; -fx-font-size: 11; -fx-padding: 10;"/>
                </VBox>
            </VBox>

            <!-- RIGHT SIDEBAR: Properties/Adjacency List (for graph) -->
            <VBox fx:id="rightSidebar" spacing="10" style="-fx-padding: 10; -fx-min-width: 280; -fx-max-width: 320; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #f9f9f9;" visible="false" managed="false">
                <Label text="Properties" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <TextArea fx:id="propsArea" 
                          editable="false" 
                          wrapText="true" 
                          prefHeight="300"
                          style="-fx-control-inner-background: #ffffff; -fx-font-size: 13; -fx-padding: 8;"/>
            </VBox>
        </HBox>
    </center>

</BorderPane>
