<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Slider?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dsavisualizer.controller.modules.Graphcontroller"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12;">

    <!-- Top: Title centered, Theme & Home buttons top-right -->
    <top>
        <BorderPane style="-fx-padding: 15 20 10 20; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <center>
                <Label fx:id="titleLabel" text="Graph"
                       style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </center>
            <right>
                <HBox spacing="10" alignment="TOP_RIGHT">
                    <Button fx:id="themeBtn" text="Dark Mode" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                    <Button fx:id="backBtn" text="Home" style="-fx-font-size: 12; -fx-padding: 8 15;"/>
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- Main content: Left panel + Center visualization + Right panel -->
    <center>
        <HBox spacing="15" style="-fx-padding: 15;">

            <!-- LEFT PANEL: Story and Operations -->
            <VBox spacing="12" style="-fx-padding: 10; -fx-min-width: 280; -fx-max-width: 320; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #f9f9f9;">

                <!-- Story/Notes Box -->
                <Label text="📖 Story" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <TextArea fx:id="storyArea"
                          editable="false"
                          wrapText="true"
                          prefHeight="120"
                          style="-fx-control-inner-background: #ffffff; -fx-font-size: 12;"/>

                <!-- Graph Type -->
                <Label text="Graph Type" style="-fx-font-weight: bold; -fx-padding: 8 0 0 0; -fx-font-size: 13;"/>
                <VBox spacing="4">
                    <CheckBox fx:id="directedCheck" text="Directed Graph" selected="true" style="-fx-font-size: 12;"/>
                </VBox>

                <!-- Add Nodes -->
                <Label text="Add/Modify Nodes" style="-fx-font-weight: bold; -fx-padding: 8 0 0 0; -fx-font-size: 13;"/>
                <TextField fx:id="nodeField" promptText="Node label" style="-fx-font-size: 13; -fx-padding: 8;"/>
                <HBox spacing="6">
                    <Button fx:id="addNodeBtn" text="Add Node" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" />
                    <Button fx:id="delNodeBtn" text="Delete Node" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #F44336; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Add Edges -->
                <Label text="Add Edge" style="-fx-font-weight: bold; -fx-padding: 8 0 0 0; -fx-font-size: 13;"/>
                <HBox spacing="6">
                    <TextField fx:id="fromField" promptText="From" style="-fx-font-size: 13; -fx-padding: 8;"/>
                    <TextField fx:id="toField" promptText="To" style="-fx-font-size: 13; -fx-padding: 8;"/>
                </HBox>
                <HBox spacing="6">
                    <Button fx:id="addEdgeBtn" text="Add Edge" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" />
                    <Button fx:id="deledgeBtn" text="Delete Edge" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Traversal -->
                <Label text="Traversal" style="-fx-font-weight: bold; -fx-padding: 8 0 0 0; -fx-font-size: 13;"/>
                <TextField fx:id="startNodeField" promptText="Start node" style="-fx-font-size: 13; -fx-padding: 8;"/>
                <HBox spacing="6">
                    <Button fx:id="dfsBtn" text="DFS" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="bfsBtn" text="BFS" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Traversal Controls -->
                <Label text="Controls" style="-fx-font-weight: bold; -fx-padding: 8 0 0 0; -fx-font-size: 13;"/>
                <HBox spacing="6">
                    <Button fx:id="startBtn" text="▶ Start" style="-fx-font-size: 12; -fx-padding: 8 12; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="stopBtn" text="⏹ Stop" style="-fx-font-size: 12; -fx-padding: 8 12; -fx-background-color: #F44336; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Slider fx:id="speedSlider" min="500" max="10000" value="2000" />

                </HBox>
                <HBox spacing="6">
                    <Button fx:id="prevBtn" text="◀ Prev" style="-fx-font-size: 12; -fx-padding: 8 12; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="nextBtn" text="Next ▶" style="-fx-font-size: 12; -fx-padding: 8 12; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Generate Random Graph -->
                <Button fx:id="randomGraphBtn" text="Random Graph" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <!-- Show Code Button with Copy -->
                <HBox spacing="8">
                    <Button fx:id="showCodeBtn" text="Show Code" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-font-weight: bold; -fx-background-color: #3F51B5; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="copyCodeBtn" text="Copy" style="-fx-font-size: 13; -fx-padding: 10 15; -fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="70"/>
                </HBox>
            </VBox>

            <!-- CENTER PANEL: Visualization + Code -->
            <VBox spacing="12" HBox.hgrow="ALWAYS">

                <!-- Visualization Area -->
                <VBox spacing="8" VBox.vgrow="ALWAYS">
                    <Label text="Visualization" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <StackPane style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #f5f5f5;" VBox.vgrow="ALWAYS">
                        <ScrollPane fx:id="vizScroll" fitToHeight="true" fitToWidth="true">
                            <StackPane fx:id="vizArea" />
                            <TextArea fx:id="stackDisplay" prefHeight="80"/> <TextArea fx:id="queueDisplay" prefHeight="80"/>
                        </ScrollPane>
                    </StackPane>
                </VBox>

                <!-- Code Box -->
                <VBox spacing="5">
                    <Label text="Code" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                    <TextArea fx:id="codeArea"
                              editable="false"
                              wrapText="false"
                              prefHeight="200"
                              style="-fx-control-inner-background: #1e1e1e; -fx-text-fill: #d4d4d4; -fx-font-family: 'Courier New'; -fx-font-size: 11; -fx-padding: 10;"/>
                </VBox>
            </VBox>

            <!-- RIGHT SIDEBAR: Adjacency List / Properties -->
            <VBox spacing="10" style="-fx-padding: 10; -fx-min-width: 280; -fx-max-width: 320; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #f9f9f9;">
                <Label text="Adjacency List" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <TextArea fx:id="propsArea"
                          editable="false"
                          wrapText="true"
                          prefHeight="400"
                          style="-fx-control-inner-background: #ffffff; -fx-font-size: 13; -fx-padding: 8;"/>
                <Label text="Graph Info" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-padding: 10 0 0 0;"/>

                <HBox spacing="5">
                    <Label text="Vertices:"/>
                    <Label fx:id="verticesLabel" text="0"/>
                </HBox>

                <HBox spacing="5">
                    <Label text="Edges:"/>
                    <Label fx:id="edgesLabel" text="0"/>
                </HBox>

                <HBox spacing="5">
                    <Label text="Tree:"/>
                    <Label fx:id="treeLabel" text="No"/>
                </HBox>

                <HBox spacing="5">
                    <Label text="Connected:"/>
                    <Label fx:id="connectedLabel" text="No"/>
                </HBox>
            </VBox>


        </HBox>
    </center>

</BorderPane>